{
  "name": "oniva-ui-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @oniva-ui/docs",
    "build": "npm run build -w oniva-ui && npm run build -w @oniva-ui/docs",
    "typecheck": "npm run typecheck -w oniva-ui && npm run typecheck -w @oniva-ui/docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:index": "npm run gen:index -w oniva-ui",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
