{
  "name": "oniva-ui",
  "version": "0.1.0",
  "description": "React design system for dashboards & agent interfaces, styled with StyleX.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/oniva-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supremeb/oniva-ui.git"
  },
  "scripts": {
    "gen:index": "node scripts/gen-index.mjs",
    "typecheck": "node scripts/gen-index.mjs && tsc --noEmit",
    "build": "node scripts/gen-index.mjs && vite build && node scripts/finalize-css.mjs && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-aria": "^3.53.1",
    "react-aria-components": "~1.22.1"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-table": "^8.21.3",
    "d3-array": "^3.2.4",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "react-stately": "^3.51.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.3.4",
    "react-aria": "^3.53.1",
    "react-aria-components": "~1.22.1"
  }
}
